# AMU.ai — Environment Configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# Optional: Google Gemini API key for AI-powered answers.
# Get a free key: https://aistudio.google.com/apikey
# Without a key the app still works using the rule-based fallback engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Port for the HTTP server (Render/Fly inject PORT automatically).
PORT=4173

# Set to "production" to hide internal error details from API responses.
NODE_ENV=development

# Max chat requests per client IP per minute (default 30).
RATE_LIMIT_MAX=30